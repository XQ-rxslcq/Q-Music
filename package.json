{
  "name": "qmusic",
  "productName": "Q-Music",
  "version": "1.2.9",
  "private": true,
  "author": "Q-Music",
  "description": "Q-Music portable player",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:compat": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "dev:win": "npm run dev:compat",
    "build": "vite build",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dist-win.ps1",
    "preview": "vite preview",
    "predev": "node ./scripts/check-node.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:regression": "vitest run",
    "ci": "vitest run",
    "gen:icon": "python scripts/gen-app-icon.py"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "dependencies": {
    "music-metadata": "^10.6.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.9"
  }
}
